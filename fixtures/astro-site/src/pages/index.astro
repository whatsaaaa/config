---
import { site } from '../site.ts'

const pages = site.pages.map((page) => `/${page}`)
---

<html lang="en">
  <head>
    <title>{site.title}</title>
  </head>
  <body>
    <ul>
      {pages.map((page) => (
        <li>
          <a href={page}>{page}</a>
        </li>
      ))}
    </ul>
  </body>
</html>
