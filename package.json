{
  "name": "config-workspace",
  "private": true,
  "description": "Shared TypeScript, lint and format configuration packages for whatsaaaa projects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "run-s build test:unit",
    "test:unit": "vitest run",
    "type-check": "run-s build type-check:ts",
    "type-check:ts": "tsc",
    "lint": "run-s build lint:oxlint lint:eslint lint:package",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:package": "pnpm --filter \"./packages/*\" lint:package",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@whatsaaaa/eslint-config": "workspace:*",
    "@whatsaaaa/format-config": "workspace:*",
    "@whatsaaaa/oxlint-config": "workspace:*",
    "@whatsaaaa/tsconfig": "workspace:*",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.21.0"
}
